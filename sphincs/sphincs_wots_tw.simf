// Winternitz parameter w = 4
#ifndef SPHINCS_WOTS_TW_SIGNATURE
#define SPHINCS_WOTS_TW_SIGNATURE

#include "../templates/array_map.simf"
#include "../templates/assert_arrays.simf"
#include "../utils.simf"
#include "../types.simf"

// The counter type bounds the loop: for_while unrolls 2^N iterations for a u{N}
// counter. With w = 4 a chain is at most 3 hashes long, so u2 (4 iterations) is
// enough -- a u8 counter would unroll the body 256 times.
fn sphincs_wots_tw_hash_n_times_iter(key_hash: u128, ctx: (u2, u32, u32, u256, u2, u32, u32, u64, u32), counter: u2) -> Either<u128, u128> {
    let (n, chain_idx, key_index, midstate, from_idx, layer_adrs, tree_adrs_1, tree_adrs_2, wots_type): (u2, u32, u32, u256, u2, u32, u32, u64, u32) = ctx;
    let (_, hashed_times): (bool, u8) = jet::add_8(<(u4, (u2, u2))>::into((0, (0, counter))), <(u4, (u2, u2))>::into((0, (0, from_idx))));

    match jet::eq_8(<(u4, (u2, u2))>::into((0, (0, counter))), <(u4, (u2, u2))>::into((0, (0, n)))) {
        true => Left(key_hash),
        false => {
            let (hash, _): (u128, u128) = <u256>::into(jet::sha_256_block(midstate, adrs_256(layer_adrs, tree_adrs_1, tree_adrs_2, wots_type, key_index, chain_idx, <(u16, (u8, u8))>::into((0, (0, hashed_times)))), sha256_tail_16(key_hash, 896)));

            Right(hash)
        }
    }
}

// Only (message_hash, idx, checksum) changes from chain to chain; the address
// fields and the midstate are the same for all 64 chains, so they travel as a
// read-only invariant instead of being copied back out of every recursion step.
fn sphincs_restore_wots_tw_signature(el: u128, ctx: (u8, u8), inv: (u128, u32, u256, u32, u32, u64, u32)) -> (u128, (u8, u8)) {
    let (idx, checksum): (u8, u8) = ctx;
    let (message_hash, key_idx, midstate, layer_adrs, tree_adrs_1, tree_adrs_2, wots_type): (u128, u32, u256, u32, u32, u64, u32) = inv;

    let (n1, n2, n3, n4): (u2, u2, u2, u2) = <u8>::into(get_byte_at_128(message_hash, jet::divide_8(idx, 4)));
    let idx_mod: u8 = jet::modulo_8(idx, 4);

    let n: u2 = match jet::eq_8(idx_mod, 0) {
        true => n1,
        false => {
            match jet::eq_8(idx_mod, 1) {
                true => n2,
                false => {
                    match jet::eq_8(idx_mod, 2) {
                        true => n3,
                        false => n4,
                    }
                }
            }
        }
    };

    let (_, s_n): (bool, u8) = jet::subtract_8(3, <(u4, (u2, u2))>::into((0, (0, n))));
    let (_, (_, s_n)): (u4, (u2, u2)) = <u8>::into(s_n);
    let (_, checksum): (bool, u8) = jet::add_8(checksum, <(u4, (u2, u2))>::into((0, (0, n))));

    (unwrap_left::<u128>(for_while::<sphincs_wots_tw_hash_n_times_iter>(el, (s_n, <(u16, (u8, u8))>::into((0, (0, idx))), key_idx, midstate, n, layer_adrs, tree_adrs_1, tree_adrs_2, wots_type))), (wrapping_add_8(idx, 1), checksum))
}

DEFINE_MAP_ARR_INV_1(u128, u128, (u8, u8), (u128, u32, u256, u32, u32, u64, u32), sphincs_restore_wots_tw_signature)
DEFINE_MAP_ARR_INV(u128, u128, (u8, u8), (u128, u32, u256, u32, u32, u64, u32), sphincs_restore_wots_tw_signature, 2, 1)
DEFINE_MAP_ARR_INV(u128, u128, (u8, u8), (u128, u32, u256, u32, u32, u64, u32), sphincs_restore_wots_tw_signature, 4, 2)
DEFINE_MAP_ARR_INV(u128, u128, (u8, u8), (u128, u32, u256, u32, u32, u64, u32), sphincs_restore_wots_tw_signature, 8, 4)
DEFINE_MAP_ARR_INV(u128, u128, (u8, u8), (u128, u32, u256, u32, u32, u64, u32), sphincs_restore_wots_tw_signature, 16, 8)
DEFINE_MAP_ARR_INV(u128, u128, (u8, u8), (u128, u32, u256, u32, u32, u64, u32), sphincs_restore_wots_tw_signature, 32, 16)
DEFINE_MAP_ARR_INV(u128, u128, (u8, u8), (u128, u32, u256, u32, u32, u64, u32), sphincs_restore_wots_tw_signature, 64, 32)

#endif
