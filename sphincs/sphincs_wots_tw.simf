fn wots_digit_sum(message_hash: u128) -> u8 {
    let (high, low): (u64, u64) = <u128>::into(message_hash);
    let high0: u64 = wrapping_add_64(jet::and_64(high, 0x3333333333333333), jet::and_64(jet::right_shift_64(2, high), 0x3333333333333333));
    let high1: u64 = wrapping_add_64(jet::and_64(high0, 0x0f0f0f0f0f0f0f0f), jet::and_64(jet::right_shift_64(4, high0), 0x0f0f0f0f0f0f0f0f));
    let high2: u64 = wrapping_add_64(jet::and_64(high1, 0x00ff00ff00ff00ff), jet::and_64(jet::right_shift_64(8, high1), 0x00ff00ff00ff00ff));
    let high3: u64 = wrapping_add_64(jet::and_64(high2, 0x0000ffff0000ffff), jet::and_64(jet::right_shift_64(16, high2), 0x0000ffff0000ffff));
    let high4: u64 = wrapping_add_64(jet::and_64(high3, 0x00000000ffffffff), jet::and_64(jet::right_shift_64(32, high3), 0x00000000ffffffff));
    let low0: u64 = wrapping_add_64(jet::and_64(low, 0x3333333333333333), jet::and_64(jet::right_shift_64(2, low), 0x3333333333333333));
    let low1: u64 = wrapping_add_64(jet::and_64(low0, 0x0f0f0f0f0f0f0f0f), jet::and_64(jet::right_shift_64(4, low0), 0x0f0f0f0f0f0f0f0f));
    let low2: u64 = wrapping_add_64(jet::and_64(low1, 0x00ff00ff00ff00ff), jet::and_64(jet::right_shift_64(8, low1), 0x00ff00ff00ff00ff));
    let low3: u64 = wrapping_add_64(jet::and_64(low2, 0x0000ffff0000ffff), jet::and_64(jet::right_shift_64(16, low2), 0x0000ffff0000ffff));
    let low4: u64 = wrapping_add_64(jet::and_64(low3, 0x00000000ffffffff), jet::and_64(jet::right_shift_64(32, low3), 0x00000000ffffffff));
    let (_, (_, (_, total))): (u32, (u16, (u8, u8))) = <u64>::into(wrapping_add_64(high4, low4));
    total
}

fn wots_chain_from_digit(value: u128, digit: u2, chain_idx: u32, adrs_hi: u128, adrs_mid: u64, midstate: u256) -> u128 {
    let (bit_high, bit_low): (u1, u1) = <u2>::into(digit);
    match <u1>::into(bit_high) {
        false => match <u1>::into(bit_low) {
            false => truncate_128(jet::sha_256_block(midstate, <(u128, u128)>::into((adrs_hi, <(u64, u64)>::into((adrs_mid, <(u32, u32)>::into((chain_idx, 2)))))), <(u128, u128)>::into((truncate_128(jet::sha_256_block(midstate, <(u128, u128)>::into((adrs_hi, <(u64, u64)>::into((adrs_mid, <(u32, u32)>::into((chain_idx, 1)))))), <(u128, u128)>::into((truncate_128(jet::sha_256_block(midstate, <(u128, u128)>::into((adrs_hi, <(u64, u64)>::into((adrs_mid, <(u32, u32)>::into((chain_idx, 0)))))), <(u128, u128)>::into((value, 0x80000000000000000000000000000380)))), 0x80000000000000000000000000000380)))), 0x80000000000000000000000000000380)))),
            true => truncate_128(jet::sha_256_block(midstate, <(u128, u128)>::into((adrs_hi, <(u64, u64)>::into((adrs_mid, <(u32, u32)>::into((chain_idx, 2)))))), <(u128, u128)>::into((truncate_128(jet::sha_256_block(midstate, <(u128, u128)>::into((adrs_hi, <(u64, u64)>::into((adrs_mid, <(u32, u32)>::into((chain_idx, 1)))))), <(u128, u128)>::into((value, 0x80000000000000000000000000000380)))), 0x80000000000000000000000000000380)))),
        },
        true => match <u1>::into(bit_low) {
            false => truncate_128(jet::sha_256_block(midstate, <(u128, u128)>::into((adrs_hi, <(u64, u64)>::into((adrs_mid, <(u32, u32)>::into((chain_idx, 2)))))), <(u128, u128)>::into((value, 0x80000000000000000000000000000380)))),
            true => value,
        },
    }
}

